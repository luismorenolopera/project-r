# El sandbox local no necesita variables. Estas son las previstas para los siguientes hitos.
# Nunca subas valores reales: copia este fichero a .env (ignorado por git).

# Supabase (Hito 3). La service_role solo la usa el servidor autoritativo.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Firma HMAC de los tiempos de speedrun (Hito 4). Distinta de la service_role.
SPEEDRUN_HMAC_KEY=

# Servidor de juego (Hito 0 de red)
COLYSEUS_PORT=2567
GECKOS_PORT=9208
GECKOS_UDP_PORT_RANGE=10000-10100
ICE_SERVERS_JSON=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Observabilidad
SENTRY_DSN=
